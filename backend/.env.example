# ==============================================================================
# SkillBridge AI Backend Environment Variables (Phase 8 Production Ready)
# ==============================================================================

PROJECT_NAME="SkillBridge AI API"
VERSION="0.8.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development" # Set to "production" in production environments

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL="https://xwzrvwnoyybhqboeuwjq.supabase.co"
SUPABASE_KEY="sb_publishable_e8SxqO4zjmx7FTQcf4ASog_rpRpTmHz"
SUPABASE_JWT_SECRET="placeholder-jwt-secret-for-development-and-testing-min-32-chars-long"
SUPABASE_JWT_ALGORITHM="HS256" # Options: HS256, RS256, ES256
SUPABASE_JWT_AUDIENCE="authenticated"

# ------------------------------------------------------------------------------
# PostgreSQL / pgvector Database Connection
# ------------------------------------------------------------------------------
DATABASE_URL="//postgres:[Vartika@1234]@db.xwzrvwnoyybhqboeuwjq.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# Rate Limiting (SlowAPI)
# ------------------------------------------------------------------------------
# Leave empty for in-memory storage (dev/testing) or configure Redis for multi-worker production
RATELIMIT_STORAGE_URL="" # e.g. "redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# RAG Embedding & LLM Provider Configuration
# ------------------------------------------------------------------------------
# In development/testing: "mock", "groq", or "openai"
# In production: "groq" or "openai" (mock providers fail startup validation)
EMBEDDING_PROVIDER="mock"
RAG_LLM_PROVIDER="groq" # Options: "groq", "openai", "mock"

# Groq API Configuration (Fast Llama 3.3 inference for RAG & Quiz Generation)
GROQ_API_KEY="gsk-placeholder-groq-api-key"
RAG_LLM_MODEL="llama-3.3-70b-versatile" # or "llama-3.1-8b-instant"

# Optional OpenAI Configuration (Required if EMBEDDING_PROVIDER="openai" or RAG_LLM_PROVIDER="openai")
OPENAI_API_KEY="sk-placeholder-openai-key"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TOP_K=4
