# ==============================================================================
# SkillBridge AI Backend Environment Variables (Phase 2)
# ==============================================================================

PROJECT_NAME="SkillBridge AI API"
VERSION="0.2.0"
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins or list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL="https://placeholder-project.supabase.co"
SUPABASE_KEY="placeholder-anon-key"
SUPABASE_JWT_SECRET="placeholder-jwt-secret-for-development-and-testing-min-32-chars-long"
SUPABASE_JWT_ALGORITHM="HS256" # Options: HS256, RS256, ES256
SUPABASE_JWT_AUDIENCE="authenticated"

# ------------------------------------------------------------------------------
# PostgreSQL / pgvector Database Connection
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql+psycopg://postgres:placeholder_password@db.placeholder-project.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# LLM Provider Placeholders
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-placeholder-openai-key"
GEMINI_API_KEY="placeholder-gemini-key"
ANTHROPIC_API_KEY="placeholder-anthropic-key"
